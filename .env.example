# Email delivery for the contact form uses Resend's HTTP API.
# Create a key at https://resend.com/api-keys and set it in your host
# (Cloudflare Pages → Settings → Environment variables) as a secret.
NUXT_RESEND_API_KEY=

# Sender address. `keyzar.my.id` is verified in Resend, so mail is sent from it.
NUXT_CONTACT_FROM=Portfolio <contact@keyzar.my.id>

# Where contact-form messages are delivered.
NUXT_CONTACT_TO=keyzazakiarkana08@gmail.com
