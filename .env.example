# Email delivery for the contact form uses Resend's HTTP API.
# Create a key at https://resend.com/api-keys and set it in your host
# (Cloudflare Pages → Settings → Environment variables) as a secret.
NUXT_RESEND_API_KEY=

# Sender address. Before verifying a domain, Resend only accepts
# `onboarding@resend.dev`, and it can only deliver to your Resend account email.
# After verifying a domain, use something like: Portfolio <contact@keyzar.my.id>
NUXT_CONTACT_FROM=onboarding@resend.dev

# Where contact-form messages are delivered.
NUXT_CONTACT_TO=keyzazaki054@gmail.com
