# SMTP delivery for the contact form. These are read server-side only and are
# never sent to the browser. Copy this file to `.env` and fill in real values.
#
# Gmail example: enable 2-Step Verification and create an "App password"
# (https://myaccount.google.com/apppasswords), then use it as NUXT_SMTP_PASS.
NUXT_SMTP_HOST=smtp.gmail.com
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=keyzazaki054@gmail.com
NUXT_SMTP_PASS=jbxj vpxc utyx zgse
# Optional: where the message is delivered from / to.
NUXT_CONTACT_FROM=keyzazaki054@gmail.com
NUXT_CONTACT_TO=keyzazaki054@gmail.com
